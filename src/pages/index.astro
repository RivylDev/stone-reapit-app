---
import { env } from 'cloudflare:workers';

import Layout from '../layouts/Layout.astro';
import { ListingCard } from '../devlink/listings/ListingCard';
import '../devlink/css/global.css';
import { search, type ListingSummary } from '../lib/queries/listings';
import {
  PUBLIC_STATUSES,
  SECTION_LIST,
  sectionHref,
  propertyHref,
} from '../lib/queries/sections';
import { fetchBlogPosts, type BlogEnv } from '../lib/webflow/cms';

/*
 * The app's index.
 *
 * Server-rendered from D1, like every other public route: hard rule 4 wants
 * listing content in view-source with JavaScript disabled, and this page is as
 * indexable as the section pages are.
 *
 * The card is the DevLink export, rendered with no `client:*` directive so it
 * runs on the server and ships as HTML. Same pattern as `ListingsBrowser`.
 *
 * What this page is NOT is `ListingCmsGrid`. That component exists in Webflow
 * and exports, but DevLink cannot carry a Collection List across — see the
 * comment at the grid below.
 */

export const prerender = false;

const FEATURED = 6;

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const db = env.DB;

let listings: ListingSummary[] = [];
let total = 0;
let failure: string | null = null;

if (!db) {
  failure = 'No D1 binding found. Run `npm run db:migrate` and `npm run db:seed`.';
} else {
  try {
    const outcome = await search(db, {
      status: [...PUBLIC_STATUSES],
      perPage: FEATURED,
      sort: 'newest',
    });
    listings = outcome.results;
    total = outcome.total;
  } catch (error) {
    failure = error instanceof Error ? error.message : String(error);
  }
}

/*
 * The other data source. Listings come from D1; the blog is authored in Webflow
 * and has no upstream system, so it is read from the CMS at render time.
 *
 * Awaited alongside nothing in particular — it is a second network hop, but the
 * CDN host caches for 300s and a miss should not hold the listings hostage, so
 * a failure here degrades to a missing section rather than a broken page.
 */
/*
 * How many posts this page shows. One number, one place — the API caps a single
 * request at 100, and `fetchAllBlogPosts` is the way past that if a page ever
 * needs the lot. `/blog` does exactly that.
 */
const BLOG_POSTS = 3;

const blog = await fetchBlogPosts(env as unknown as BlogEnv, BLOG_POSTS);

/*
 * Blog posts live on the Webflow site, not in this app. Their URLs sit at the
 * site root under the collection slug — deliberately *not* prefixed with the
 * mount path, which only addresses routes this app serves.
 */
const blogHref = (slug: string) => `/blog/${slug}`;

const contactHref = (slug: string) => `${propertyHref(base, slug)}#contact-heading`;
const numberFormat = new Intl.NumberFormat('en-AU');
---

<Layout
  title="Stone Real Estate — property listings"
  description="Properties for sale and rent with Stone Real Estate, across NSW, QLD, ACT, VIC and TAS."
>
  <main class="home">
    <header class="hero">
      <p class="eyebrow">Stone Real Estate</p>
      <h1 class="hero-title">Find your next property</h1>
      {total > 0 && (
        <p class="hero-count">
          {numberFormat.format(total)} properties listed across {SECTION_LIST.length - 1} categories
        </p>
      )}

      <nav class="sections" aria-label="Browse listings">
        {SECTION_LIST.map((section) => (
          <a class="section-link" href={sectionHref(base, section)}>
            {section.label}
          </a>
        ))}
      </nav>
    </header>

    {failure && (
      <p class="failure" role="status">{failure}</p>
    )}

    {!failure && listings.length === 0 && (
      <p class="failure" role="status">No listings yet. Run `npm run db:seed` to load the fixtures.</p>
    )}

    {listings.length > 0 && (
      <section class="featured" aria-labelledby="featured-heading">
        <div class="featured-head">
          <h2 class="featured-title" id="featured-heading">Latest listings</h2>
          <a class="see-all" href={sectionHref(base, SECTION_LIST[0])}>
            See all properties
          </a>
        </div>

        {/*
          Where ListingCmsGrid would have gone.

          The Webflow component exports, but its Collection List, Collection
          List Items and Empty State come across as `NotSupported` placeholders
          that render error text and no cards — DevLink carries presentation,
          not a CMS binding. So the repeat happens here instead, over rows from
          D1, and each row renders through the card component that *did* export.

          To make ListingCmsGrid itself usable, the Webflow component needs its
          Collection List swapped for a plain Div Block containing one Listing
          Card. Then DevLink can export the layout and Astro supplies the
          repetition, which is the same division of labour as this grid.
        */}
        <div class="listings-grid">
          {listings.map((listing) => (
            <div class="listing-card-slot">
              <a class="listing-card-link" href={propertyHref(base, listing.slug)}>
                <span class="visually-hidden">
                  View {listing.streetAddress || listing.displayAddress}, {listing.suburb}
                </span>
              </a>
              <ListingCard
                listingListingId={listing.listingId}
                listingSuburb={`${listing.suburb} ${listing.state}`}
                listingDisplayAddress={listing.streetAddress}
                listingPriceDisplay={listing.priceDisplay}
                listingBedrooms={listing.bedrooms ?? undefined}
                listingBathrooms={listing.bathrooms ?? undefined}
                listingCarspaces={listing.carspaces ?? undefined}
                listingPhotoCount={listing.photoCount}
                agentAgentName={listing.agentName ?? 'Stone'}
                agentAgentPhone={listing.agentPhone ?? ''}
                agentContactUrl={{ href: contactHref(listing.slug) }}
                openHomeHasOpenTimes={false}
              />
            </div>
          ))}
        </div>
      </section>
    )}

    {/*
      Webflow CMS, server-rendered.

      Nothing here is a Collection List — DevLink cannot carry one across. The
      markup is authored in Astro and the rows come from the Data API, which is
      the same division of labour as the listings grid above: Webflow owns
      presentation, this file owns the repeat.
    */}
    {blog.posts && blog.posts.length > 0 && (
      <section class="blog" aria-labelledby="blog-heading">
        <div class="featured-head">
          <h2 class="featured-title" id="blog-heading">From the blog</h2>
          <a class="see-all" href={`${base}/blog`}>
            All posts{blog.total !== null ? ` (${blog.total})` : ''}
          </a>
        </div>

        <ul class="post-list">
          {blog.posts.map((post) => (
            <li class="post">
              <a class="post-title" href={blogHref(post.slug)}>{post.name}</a>
              {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
              <p class="post-meta">
                {post.author}{post.author && post.date ? ' · ' : ''}{post.date}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {blog.error && (
      <p class="failure" role="status">Blog unavailable — {blog.error}</p>
    )}
  </main>
</Layout>

<style>
  .home {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--stone-space-lg, 32px) var(--stone-space-md, 20px) 64px;
  }

  .hero { margin-bottom: var(--stone-space-lg, 32px); }

  .eyebrow {
    margin: 0 0 8px;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stone-muted, #6b6e6b);
  }

  .hero-title {
    margin: 0 0 8px;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
  }

  .hero-count {
    margin: 0 0 20px;
    color: var(--stone-muted, #6b6e6b);
    font-variant-numeric: tabular-nums;
  }

  .sections { display: flex; flex-wrap: wrap; gap: 8px; }

  .section-link {
    padding: 7px 15px;
    border: 1px solid var(--stone-border, #e0e0e0);
    border-radius: 999px;
    text-decoration: none;
    color: inherit;
    font-size: 0.9375rem;
  }
  .section-link:hover { border-color: var(--stone-action, #20504a); }
  .section-link:focus-visible {
    outline: 2px solid var(--stone-action, #20504a);
    outline-offset: 2px;
  }

  .featured-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: var(--stone-space-md, 20px);
  }

  .featured-title { margin: 0; font-size: 1.25rem; }

  .see-all { color: var(--stone-action, #20504a); font-size: 0.9375rem; }

  /* Three across, matching the results grid on the section pages. */
  .listings-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--stone-space-md, 20px);
  }

  /*
    Whole-card link. `:global()` is what lets a scoped style reach the DevLink
    markup, which Astro's scoping cannot tag — it only rewrites elements this
    file authors. Descendant rather than child, because DevLink wraps the card
    in a `display: contents` scope div.
  */
  .listing-card-slot { position: relative; display: flex; }
  .listing-card-slot :global(.listing-card) { flex: 1; min-width: 0; }

  .listing-card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--stone-radius-md, 8px);
  }
  .listing-card-slot:hover {
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.08);
    border-radius: var(--stone-radius-md, 8px);
  }
  .listing-card-link:focus-visible {
    outline: 2px solid var(--stone-action, #20504a);
    outline-offset: 2px;
  }

  /* Keeps the agent's own link clickable above the card overlay. */
  .listing-card-slot :global(.contact-agent) { position: relative; z-index: 2; }

  .blog { margin-top: 56px; }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--stone-space-md, 20px);
  }

  .post {
    padding: 18px 20px;
    border: 1px solid var(--stone-border, #e0e0e0);
    border-radius: var(--stone-radius-md, 8px);
  }

  .post-title {
    display: block;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    color: inherit;
    text-decoration: none;
  }
  .post-title:hover { text-decoration: underline; }
  .post-title:focus-visible {
    outline: 2px solid var(--stone-action, #20504a);
    outline-offset: 2px;
  }

  .post-excerpt {
    margin: 8px 0 0;
    font-size: 0.9375rem;
    color: var(--stone-muted, #6b6e6b);
  }

  .post-meta {
    margin: 12px 0 0;
    font-size: 0.8125rem;
    color: var(--stone-muted, #6b6e6b);
  }

  .failure {
    padding: 16px 18px;
    border: 1px solid var(--stone-border, #e0e0e0);
    border-radius: var(--stone-radius-md, 8px);
    color: var(--stone-muted, #6b6e6b);
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    margin: -1px; padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1024px) {
    .listings-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .post-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 640px) {
    .listings-grid { grid-template-columns: minmax(0, 1fr); }
    .post-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
