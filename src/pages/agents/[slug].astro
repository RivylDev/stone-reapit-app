---
import { env } from 'cloudflare:workers';

import Layout from '../../layouts/Layout.astro';
import { findAgentBySlug, type AgentDetail } from '../../lib/queries/directory';
import { search, DEFAULT_PER_PAGE, type ListingSummary } from '../../lib/queries/listings';
import {
  PUBLIC_STATUSES,
  agentHref,
  agentsHref,
  officeHref,
  propertyHref,
} from '../../lib/queries/sections';
import { toParagraphs, toPlainText } from '../../lib/rich-text';
import '../../styles/directory.css';

/*
 * One agent's profile.
 *
 * `findAgentBySlug` applies the publication policy, so this route 404s for a
 * back-office or integration account even when the slug is guessed correctly.
 * The check is in the query rather than the template on purpose — a template
 * guard is one refactor away from being dropped.
 */
export const prerender = false;

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const db = env.DB;
const slug = Astro.params.slug ?? '';

let agent: AgentDetail | null = null;
let listings: ListingSummary[] = [];
let failure: string | null = null;

if (!db) {
  failure = 'No D1 binding found. Run `npm run db:migrate` and `npm run db:seed`.';
} else {
  try {
    agent = await findAgentBySlug(db, slug);

    if (agent && agent.slug !== slug) {
      return Astro.redirect(agentHref(base, agent.slug), 301);
    }

    if (agent) {
      const outcome = await search(db, {
        agentId: agent.agentId,
        status: [...PUBLIC_STATUSES],
        perPage: DEFAULT_PER_PAGE,
      });
      listings = outcome.results;
    }
  } catch (error) {
    failure = error instanceof Error ? error.message : String(error);
  }
}

if (failure) Astro.response.status = 500;
else if (!agent) Astro.response.status = 404;

/*
 * Every populated staff profile in the sandbox is HTML. `toParagraphs` turns it
 * into plain paragraphs, which are then rendered as text — never set:html,
 * since this copy is typed into a CRM and is not trusted.
 */
const paragraphs = toParagraphs(agent?.profile);

const telHref = (phone: string) => `tel:${phone.replace(/\s+/g, '')}`;
const subtitle = agent ? (agent.jobTitle || agent.role || '') : '';

const title = agent
  ? `${agent.fullName}${subtitle ? `, ${subtitle}` : ''} — Stone`
  : 'Agent not found — Stone';

const metaDescription = agent
  ? (toPlainText(agent.profile, 300)
    || `${agent.fullName}${subtitle ? `, ${subtitle}` : ''}`
      + `${agent.officeName ? ` at ${agent.officeName}` : ''}. `
      + `${agent.listingCount} propert${agent.listingCount === 1 ? 'y' : 'ies'} currently listed.`)
  : undefined;

const canonical = agent ? `${Astro.url.origin}${agentHref(base, agent.slug)}` : undefined;
---

<Layout title={title} description={metaDescription} canonical={canonical}>
  <section class="dir-section">
    <div class="dir-container">
      {failure && <p class="dir-error">{failure}</p>}

      {!failure && !agent && (
        <>
          <h1 class="dir-title">Agent not found</h1>
          <p class="dir-empty">This person is not listed on the site.</p>
          <a class="dir-back" href={agentsHref(base)}>← All agents</a>
        </>
      )}

      {agent && (
        <>
          <nav class="dir-breadcrumb" aria-label="Breadcrumb">
            <a href={agentsHref(base)}>Our people</a>
            {agent.officeName && agent.officeSlug && (
              <>
                <span aria-hidden="true">/</span>
                <a href={officeHref(base, agent.officeSlug)}>{agent.officeName}</a>
              </>
            )}
            <span aria-hidden="true">/</span>
            <span aria-current="page">{agent.fullName}</span>
          </nav>

          <h1 class="dir-title">{agent.fullName}</h1>
          {subtitle && <p class="dir-lede">{subtitle}</p>}

          <div class="dir-detail-layout">
            <div class="dir-main">
              {paragraphs.length > 0 && (
                <div class="dir-prose">
                  {paragraphs.map((block) => <p>{block}</p>)}
                </div>
              )}

              {agent.specialistAreas.length > 0 && (
                <section class="dir-main" aria-labelledby="areas-heading">
                  <h2 class="dir-heading" id="areas-heading">Specialist areas</h2>
                  <ul class="dir-tags">
                    {agent.specialistAreas.map((area) => <li>{area}</li>)}
                  </ul>
                </section>
              )}

              {listings.length > 0 && (
                <section class="dir-main" aria-labelledby="listings-heading">
                  <h2 class="dir-heading" id="listings-heading">
                    Properties with {agent.firstName ?? agent.fullName}
                  </h2>
                  <ul class="dir-grid">
                    {listings.map((listing) => (
                      <li class="dir-card">
                        <h3 class="dir-card-title">
                          <a href={propertyHref(base, listing.slug)}>
                            {listing.streetAddress || listing.displayAddress}
                          </a>
                        </h3>
                        <p class="dir-card-line">{listing.suburb} {listing.state}</p>
                        <p class="dir-card-meta">{listing.priceDisplay || 'Contact agent'}</p>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {paragraphs.length === 0 && listings.length === 0 && (
                <p class="dir-empty">
                  No profile or current listings for {agent.fullName}.
                </p>
              )}
            </div>

            <aside class="dir-aside">
              <section class="dir-panel" aria-labelledby="contact-heading">
                <h2 class="dir-heading" id="contact-heading">Get in touch</h2>
                {agent.photoUrl
                  ? <img class="dir-avatar" src={agent.photoUrl} alt={agent.fullName} loading="lazy" />
                  : <div class="dir-avatar" role="presentation"></div>}
                {agent.phone && (
                  <p class="dir-card-line"><a href={telHref(agent.phone)}>{agent.phone}</a></p>
                )}
                {agent.email && (
                  <p class="dir-card-line">
                    <a href={`mailto:${agent.email}`}>{agent.email}</a>
                  </p>
                )}
                {agent.officeName && agent.officeSlug && (
                  <p class="dir-card-line">
                    <a href={officeHref(base, agent.officeSlug)}>{agent.officeName}</a>
                  </p>
                )}
              </section>
            </aside>
          </div>

          <a class="dir-back" href={agentsHref(base)}>← All agents</a>
        </>
      )}
    </div>
  </section>
</Layout>
