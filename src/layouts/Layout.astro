---
import "../styles/global.css";

interface Props {
  title?: string;
  /** Meta description. Omitted from the head when absent, never emitted empty. */
  description?: string;
  /** Absolute canonical URL. Listing pages set it so that the filtered routes
   *  that link into them do not fragment the same page across several URLs. */
  canonical?: string;
}

const {
  title = "Webflow Cloud Astro App",
  description,
  canonical,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${(import.meta.env.BASE_URL || "/").replace(/\/$/, "")}/astro.svg`}
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body>
    <slot />
  </body>
</html>
