---
import { env } from 'cloudflare:workers';

import Layout from '../layouts/Layout.astro';
/*
 * The real DevLink export, generated from the Webflow component by
 * `npm run devlink:export`. Its CSS travels with it and must be imported too —
 * the classes are scoped to a generated wrapper class, so nothing here leaks
 * into the rest of the site.
 */
import { ListingCard } from '../devlink/listings/ListingCard';
/*
 * One barrel, not the five files it re-exports. `global.css` wraps each in a
 * CSS `@layer` — normalize, defaults, variables, tags, classes — and that
 * ordering is what keeps Webflow's own resets from outranking this app's
 * styles. Importing the five directly drops the layers and the cascade fights.
 */
import '../devlink/css/global.css';
import { search, DEFAULT_PER_PAGE, type SearchOutcome } from '../lib/queries/listings';
import {
  PARAM,
  readRawFilters,
  toSearchParams,
  buildQueryString,
  hasAnyFilter,
} from '../lib/queries/params';
import {
  SECTION_LIST,
  sectionHref,
  propertyHref,
  type ListingSection,
} from '../lib/queries/sections';

/*
 * The body of every section page: /properties, /buy, /rent, /sold, /leased.
 * Each of those is a five-line page at the app's mount root that hands this
 * component its section.
 *
 * `prerender = false` lives on the pages, not here; a component cannot set it.
 */

interface Props {
  section: ListingSection;
}

const { section } = Astro.props;

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const actionPath = sectionHref(base, section);

// Anchors the card's Contact Agent link on the detail page's agent panel.
const contactHref = (slug: string) => `${propertyHref(base, slug)}#contact-heading`;

const raw = readRawFilters(Astro.url);

/*
 * Status is the path now, so it must not survive as a query parameter: blanking
 * it here keeps it out of the filter form, the tab links, the pagination links
 * and the canonical URL, so one result set cannot be reached at two URLs.
 */
raw.status = '';

const params = toSearchParams(raw);

/*
 * The section decides the statuses, unconditionally and last. A hand-typed
 * `?status=withdrawn` cannot widen the set — it was blanked above, and this
 * would overwrite it regardless.
 */
params.status = section.statuses;

// Astro 7 removed `Astro.locals.runtime.env`; bindings come from cloudflare:workers.
const db = env.DB;

let outcome: SearchOutcome | null = null;
let failure: string | null = null;

if (!db) {
  failure =
    'No D1 binding found. Run `npm run db:migrate` and `npm run db:seed`, then '
    + 'start the app with `npm run preview` so the binding is available.';
} else {
  try {
    outcome = await search(db, { ...params, perPage: DEFAULT_PER_PAGE });

    /*
     * A page number past the end would otherwise render an empty grid under a
     * 200 and a canonical of its own — an indexable empty page, and a soft 404.
     * It happens on its own as listings sell and the page count shrinks under a
     * bookmarked or already-indexed URL.
     *
     * Serve the last real page instead and canonicalise to it (below). The
     * re-query only runs on the out-of-range request, which is rare.
     */
    if (outcome.totalPages > 0 && outcome.page > outcome.totalPages) {
      outcome = await search(db, {
        ...params,
        page: outcome.totalPages,
        perPage: DEFAULT_PER_PAGE,
      });
    }
  } catch (error) {
    failure = error instanceof Error ? error.message : String(error);
  }
}

const PROPERTY_TYPES = [
  'House', 'Apartment', 'Townhouse', 'Villa', 'Unit', 'Duplex', 'Studio',
  'Land', 'Acreage', 'Farm', 'Lifestyle', 'Office', 'Retail', 'Warehouse', 'Showroom',
];

const PRICE_STEPS = [
  250000, 500000, 750000, 1000000, 1250000, 1500000, 2000000, 3000000, 5000000,
];

const SORT_LABELS: Record<string, string> = {
  newest: 'Newest',
  priceAsc: 'Price: low to high',
  priceDesc: 'Price: high to low',
  suburb: 'Suburb A–Z',
};

const COUNT_OPTIONS = ['1', '2', '3', '4', '5'];

const money = (value: number) =>
  value >= 1000000 ? `$${value / 1000000}m` : `$${value / 1000}k`;

const page = outcome?.page ?? 1;
const totalPages = outcome?.totalPages ?? 0;
const total = outcome?.total ?? 0;

/*
 * Tab counts come free. `search()` already computes the status facet with every
 * filter applied except status itself, which is exactly the question a tab
 * asks: given these filters, how many are there in that section? No extra
 * query — and summing only the section's own statuses is what keeps `withdrawn`
 * out of the totals, since the facet itself counts every status.
 */
const statusCounts = outcome?.facetCounts.status ?? {};

const tabs = SECTION_LIST.map((entry) => ({
  slug: entry.slug,
  label: entry.label,
  current: entry.slug === section.slug,
  // Filters follow you across sections; the page number does not.
  href: sectionHref(base, entry, buildQueryString(raw, { page: undefined })),
  count: outcome
    ? entry.statuses.reduce((sum, status) => sum + (statusCounts[status] ?? 0), 0)
    : null,
}));

/*
 * A suburb filter turns a section into a page about a place, which is the query
 * people actually search. Reflecting it in the heading, the title and the
 * description is most of what makes those pages rank.
 */
const placeSuffix = raw.keywords ? ` in ${raw.keywords}` : '';
const heading = `${section.heading}${placeSuffix}`;

const pageSuffix = page > 1 ? ` — page ${page}` : '';
const title = `${heading}${pageSuffix} — Stone`;

const noun = total === 1 ? 'property' : 'properties';
const metaDescription = hasAnyFilter(raw)
  ? `${total} ${noun} ${section.phrase}${placeSuffix} with Stone.`
  : section.blurb;

/*
 * Self-referencing, filters and page included: this URL is the canonical one
 * for this result set, and no other URL now produces it.
 *
 * The page number is the one actually rendered, not the one asked for, so an
 * out-of-range request points at the page it was served rather than claiming to
 * be a page that does not exist.
 */
const canonical = `${Astro.url.origin}${actionPath}${buildQueryString(raw, {
  page: page === 1 ? undefined : page,
})}`;

const prevHref = `${actionPath}${buildQueryString(raw, { page: page - 1 === 1 ? undefined : page - 1 })}`;
const nextHref = `${actionPath}${buildQueryString(raw, { page: page + 1 })}`;
---

<Layout title={title} description={metaDescription} canonical={canonical}>
  <section class="listings-section">
    <div class="listings-container">
      <h1 class="listings-title">{heading}</h1>

      <!--
        Sections are links, not a select. Each one is a real URL that a crawler
        follows and a person can bookmark, and switching section carries the
        active filters across so the tabs behave like the filter they replaced.
      -->
      <nav class="section-tabs" aria-label="Listing sections">
        {tabs.map((tab) => (
          <a
            class:list={['section-tab', { 'section-tab-current': tab.current }]}
            href={tab.href}
            aria-current={tab.current ? 'page' : undefined}
          >
            <span>{tab.label}</span>
            {tab.count !== null && <span class="section-tab-count">{tab.count}</span>}
          </a>
        ))}
      </nav>

      <!--
        Filters sit beside the results rather than stacked above them: an aside
        alongside the main column, so the grid gets the full remaining width.
      -->
      <div class="listings-layout">
        <aside class="filters-col" aria-labelledby="filters-heading">
          <h2 class="visually-hidden" id="filters-heading">Filter listings</h2>
          <!--
            A plain GET form. No Webflow form runtime, no AJAX, no client JS —
            submitting navigates and the server renders the result. The action
            is the section's own path, so filtering never leaves the section.
          -->
          <form class="search-form" method="get" action={actionPath}>
          <div class="field-group field-group-full">
            <label class="field-label" for="filter-keywords">Suburb</label>
            <input
              class="field-input"
              id="filter-keywords"
              type="text"
              name={PARAM.keywords}
              value={raw.keywords}
              placeholder="e.g. Manly"
              autocomplete="off"
            />
          </div>

          <div class="filter-fields">
            <div class="field-group">
              <label class="field-label" for="filter-property-type">Property Type</label>
              <select class="field-select" id="filter-property-type" name={PARAM.propertyType}>
                <option value="">Any type</option>
                {PROPERTY_TYPES.map((type) => (
                  <option value={type} selected={raw.property_type === type}>{type}</option>
                ))}
              </select>
            </div>

            <div class="field-group">
              <span class="field-label">Price Range</span>
              <div class="price-inputs">
                <select class="field-select field-select-sm" name={PARAM.priceMin} aria-label="Minimum price">
                  <option value="">No min</option>
                  {PRICE_STEPS.map((value) => (
                    <option value={String(value)} selected={raw.price_min === String(value)}>
                      {money(value)}
                    </option>
                  ))}
                </select>
                <select class="field-select field-select-sm" name={PARAM.priceMax} aria-label="Maximum price">
                  <option value="">No max</option>
                  {PRICE_STEPS.map((value) => (
                    <option value={String(value)} selected={raw.price_max === String(value)}>
                      {money(value)}
                    </option>
                  ))}
                </select>
              </div>
            </div>

            <div class="field-group">
              <label class="field-label" for="filter-bedrooms">Bedrooms</label>
              <select class="field-select" id="filter-bedrooms" name={PARAM.bedrooms}>
                <option value="">Any</option>
                {COUNT_OPTIONS.map((n) => (
                  <option value={n} selected={raw.bedrooms === n}>{n}+</option>
                ))}
              </select>
            </div>

            <div class="field-group">
              <label class="field-label" for="filter-bathrooms">Bathrooms</label>
              <select class="field-select" id="filter-bathrooms" name={PARAM.bathrooms}>
                <option value="">Any</option>
                {COUNT_OPTIONS.map((n) => (
                  <option value={n} selected={raw.bathrooms === n}>{n}+</option>
                ))}
              </select>
            </div>

            <div class="field-group">
              <label class="field-label" for="filter-carspaces">Carspaces</label>
              <select class="field-select" id="filter-carspaces" name={PARAM.carspaces}>
                <option value="">Any</option>
                {COUNT_OPTIONS.map((n) => (
                  <option value={n} selected={raw.carspaces === n}>{n}+</option>
                ))}
              </select>
            </div>

            <!--
              Sort lives inside the filter form on purpose. As a separate form
              it would submit alone and drop every active filter.
            -->
            <div class="field-group">
              <label class="field-label" for="filter-sort">Sort</label>
              <select class="field-select" id="filter-sort" name={PARAM.sort}>
                {Object.entries(SORT_LABELS).map(([value, label]) => (
                  <option value={value} selected={raw.sort === value}>{label}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="search-actions">
            <button class="search-button" type="submit">Search</button>
            {hasAnyFilter(raw) && <a class="clear-link" href={actionPath}>Clear filters</a>}
          </div>
          </form>
        </aside>

        <div class="results-col">
      {failure && <p class="listings-error">{failure}</p>}

      {outcome && (
        <>
          <div class="results-toolbar">
            <p class="results-count">
              {total === 0
                ? 'No properties match these filters'
                : `${total} ${noun}`}
              {totalPages > 1 && ` — page ${page} of ${totalPages}`}
            </p>
          </div>

          <div class="listings-grid">
            {/*
              The DevLink card mounted as an Astro island. There is no client:*
              directive on purpose — without one Astro renders the React
              component to HTML on the server and ships no JavaScript for it,
              which is what keeps listing content in view-source.
            */}
            {/*
              Prop names are DevLink's, not ours. Webflow prefixes each property
              with the name of the group it sits in inside the Designer —
              `suburb` in the Listing group arrives as `listingSuburb`. The
              canonical names live on the left of each line; do not rename the
              right-hand side, it is regenerated on every export.

              `agentContactUrl` is a Link object rather than a string, which is
              how DevLink models any Webflow Link element.
            */}
            {outcome.results.map((listing) => (
              /*
                The card is wrapped, not linked. DevLink's card already contains
                a Contact Agent anchor and an <a> cannot nest inside another, so
                the whole-card link is an overlay stretched across the slot with
                the Contact Agent link raised above it. Both are real anchors in
                the markup, so both are crawlable and neither needs JavaScript.
              */
              <div class="listing-card-slot">
                <a class="listing-card-link" href={propertyHref(base, listing.slug)}>
                  <span class="visually-hidden">
                    View {listing.streetAddress || listing.displayAddress}, {listing.suburb}
                  </span>
                </a>
                <ListingCard
                  listingListingId={listing.listingId}
                  listingSuburb={`${listing.suburb} ${listing.state}`}
                  listingDisplayAddress={listing.streetAddress}
                  listingPriceDisplay={listing.priceDisplay}
                  listingBedrooms={listing.bedrooms ?? undefined}
                  listingBathrooms={listing.bathrooms ?? undefined}
                  listingCarspaces={listing.carspaces ?? undefined}
                  listingPhotoCount={listing.photoCount}
                  agentAgentName={listing.agentName ?? 'Stone'}
                  agentAgentPhone={listing.agentPhone ?? ''}
                  agentContactUrl={{ href: contactHref(listing.slug) }}
                  openHomeHasOpenTimes={false}
                />
              </div>
            ))}
          </div>

          {totalPages > 1 && (
            <nav class="pagination" aria-label="Pagination">
              {page > 1 && <a class="page-link" rel="prev" href={prevHref}>Previous</a>}
              <span class="page-status">Page {page} of {totalPages}</span>
              {page < totalPages && <a class="page-link" rel="next" href={nextHref}>Next</a>}
            </nav>
          )}
        </>
      )}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /*
    Page furniture only. Card styling travels with the component in
    ListingCard.css — the shape DevLink emits — and Astro's scoped styles could
    not reach that React markup anyway, since scoping only tags Astro-authored
    elements. Colours come from the Stone tokens in global.css.
  */

  .listings-section { padding: var(--stone-space-lg) var(--stone-space-md); }
  .listings-container { width: 100%; max-width: var(--stone-container-max); margin: 0 auto; }
  .listings-title { margin: 0 0 var(--stone-space-md); font-size: 2rem; line-height: 1.2; }

  .section-tabs {
    display: flex; flex-wrap: wrap; gap: var(--stone-space-xs);
    margin-bottom: var(--stone-space-lg);
    border-bottom: 1px solid var(--stone-border);
  }
  .section-tab {
    display: flex; align-items: center; gap: 6px;
    padding: 8px 14px; margin-bottom: -1px;
    border-bottom: 2px solid transparent;
    color: var(--stone-ink-muted); text-decoration: none;
    font-size: 0.95rem;
  }
  .section-tab-current {
    border-bottom-color: var(--stone-action);
    color: var(--stone-ink); font-weight: 600;
  }
  .section-tab-count {
    padding: 1px 7px; border-radius: 999px;
    background: var(--stone-surface-subtle);
    font-size: 0.75rem; font-weight: 400;
  }

  /* Sidebar beside results. minmax(0,1fr) stops long content blowing the grid
     out past the container, which `1fr` alone allows. */
  .listings-layout {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr);
    gap: var(--stone-space-lg);
    align-items: start;
  }

  .filters-col {
    position: sticky;
    top: var(--stone-space-md);
    border: 1px solid var(--stone-border);
    border-radius: var(--stone-radius-md);
    padding: var(--stone-space-md);
    background: var(--stone-surface);
  }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap;
  }

  .search-form { display: flex; flex-direction: column; gap: var(--stone-space-sm); }
  .filter-fields { display: flex; flex-direction: column; gap: var(--stone-space-sm); }
  .field-group { display: flex; flex-direction: column; gap: 4px; }
  .field-label { font-size: 0.78rem; font-weight: 600; color: var(--stone-ink-muted); }

  .field-input,
  .field-select {
    width: 100%;
    padding: 8px 10px;
    border: 1px solid var(--stone-border);
    border-radius: var(--stone-radius-sm);
    background: var(--stone-surface);
    color: var(--stone-ink);
    font: inherit;
    font-size: 0.9rem;
  }

  .price-inputs { display: flex; gap: var(--stone-space-xs); }
  .price-inputs .field-select { flex: 1; min-width: 0; }

  .search-actions {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--stone-space-sm); margin-top: 4px;
  }
  .search-button {
    padding: 10px 22px; border: 0;
    border-radius: var(--stone-radius-sm);
    background: var(--stone-action); color: var(--stone-action-text);
    font: inherit; font-size: 0.9rem; cursor: pointer;
  }
  .clear-link { font-size: 0.85rem; color: var(--stone-ink-muted); }

  .results-col { display: flex; flex-direction: column; gap: var(--stone-space-md); }
  .results-toolbar { display: flex; align-items: center; }
  .results-count { margin: 0; font-size: 0.95rem; color: var(--stone-ink-muted); }

  .listings-error {
    padding: var(--stone-space-sm);
    border: 1px solid #c0392b; border-radius: var(--stone-radius-sm);
    color: #c0392b;
  }

  /* Three across in the results column, as asked. */
  .listings-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--stone-space-md);
  }

  /*
    Whole-card link. The overlay covers the slot; `:global()` is what lets a
    scoped style reach the DevLink markup, which Astro's scoping cannot tag —
    it only rewrites elements this file authors. Raising .contact-agent above
    the overlay keeps its own destination clickable.
  */
  /* Descendant, not child: DevLink wraps the card in a `display: contents`
     scope div, so .listing-card is the flex item but not the DOM child. */
  .listing-card-slot { position: relative; display: flex; }
  .listing-card-slot :global(.listing-card) { flex: 1; min-width: 0; }

  .listing-card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--stone-radius-md);
  }
  .listing-card-slot:hover { box-shadow: 0 2px 12px rgb(0 0 0 / 0.08); border-radius: var(--stone-radius-md); }
  .listing-card-link:focus-visible { outline: 2px solid var(--stone-action); outline-offset: 2px; }

  .listing-card-slot :global(.contact-agent) { position: relative; z-index: 2; }

  .pagination {
    display: flex; align-items: center; justify-content: center;
    gap: var(--stone-space-md); margin-top: var(--stone-space-md);
    font-size: 0.9rem;
  }

  /* Sidebar drops above the results before the cards get too narrow to read. */
  @media (max-width: 60rem) {
    .listings-layout { grid-template-columns: minmax(0, 1fr); gap: var(--stone-space-md); }
    .filters-col { position: static; }
    .filter-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); }
    .listings-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 36rem) {
    .listings-section { padding: var(--stone-space-md) var(--stone-space-sm); }
    .listings-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
