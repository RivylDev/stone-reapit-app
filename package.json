{
  "name": "astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "vite": "^8"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "webflow cloud deploy",
    "astro": "astro",
    "cf-typegen": "wrangler types",
    "devlink:export": "webflow devlink export",
    "fixtures": "node scripts/generate-dev-fixtures.mjs",
    "db:migrate": "wrangler d1 migrations apply stone-listings --local",
    "db:seed": "node --experimental-strip-types scripts/seed-d1.ts",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.0",
    "@astrojs/react": "^6.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "astro": "^7.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250415.0",
    "@webflow/webflow-cli": "^2.4.0",
    "wrangler": "^4.83.0"
  }
}
